# Shopify Storefront API — the Glizzy Store headless storefront.
#
# Same store as vinton.land and mmmornings; a DIFFERENT headless storefront,
# which is what keeps the three catalogues apart. This token can only see
# products published to that storefront.
#
# PUBLIC_ on purpose: Astro inlines PUBLIC_* into the shipped JS and the cart
# needs it in the browser. A Storefront PUBLIC token is designed to be read by
# anyone and grants only what a shopper can already do. A PRIVATE token must
# never go in a PUBLIC_ variable.
PUBLIC_SHOPIFY_STORE_DOMAIN=vintonland.myshopify.com
PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
