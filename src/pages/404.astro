---
/**
 * The page a wrong URL lands on. There was none until 2026-09-09, which meant
 * Netlify served its own generic one — a dead end with no route back into the
 * site, for a person and for a crawler that arrived on a stale link alike.
 *
 * It wears the colophon's clothes: `scripts={false}`, the fixed mark, one
 * WindowPanel. `scripts={false}` is doing real work here and is not a
 * micro-optimisation — it drops the three.js dog AND the four-screen
 * `body.has-dog` height that the dog assumes, and without it this page would
 * open onto three empty screens before anyone saw the words.
 *
 * `noindex` because a 404 is not a page anyone should arrive at from a search
 * result. It stays out of the sitemap for free: the hand-rolled sitemap
 * integration in astro.config.mjs skips any page whose HTML carries the
 * noindex meta.
 *
 * ONE WAY OUT, not a menu. This carried a line of copy, three links (Home, The
 * glizzy, Colophon) and a quiet Back pill, on the reasoning that recovery is
 * the whole job of the page and more routes out is more recovery. In front of
 * it that reads as a site map on a dead end: four things to choose between
 * when the only thing anyone wants is to not be here. Adam's call, 2026-09-10
 * — the name of the problem and the standard blue pill home, nothing else.
 */
import Layout from '../layouts/Layout.astro';
import SiteIcon from '../components/SiteIcon.astro';
import WindowPanel from '../components/WindowPanel.astro';
---

<Layout
  title="Not found — Glizzy Store"
  description="That page is not here. The glizzy is."
  scripts={false}
  noindex
>
  <SiteIcon />

  <main class="notfound">
    <section class="notfound__slot" aria-labelledby="notfound-title">
      <WindowPanel title="404">
        <div class="notfound__body">
          <h1 class="notfound__title f-sequoia" id="notfound-title">Not found</h1>
          {/*
            `.shop-button` with no modifier is the site's standard CTA: the blue
            pill, navy on `--cta`, full width. The `--quiet` variant that used to
            be here is the mustard outline, which is the SECONDARY treatment —
            fine beside a primary action and wrong as the only one on a page.
          */}
          <a class="shop-button notfound__home" href="/">Home</a>
        </div>
      </WindowPanel>
    </section>
  </main>
</Layout>

<style>
/* Same slot geometry as /colophon — one panel, centred, with room above it for
   the fixed mark in the corner. */
.notfound {
  display: flex;
  justify-content: center;
  padding: clamp(5rem, 14vh, 9rem) 1rem 4rem;
}

.notfound__slot {
  width: min(38rem, 100%);
  /*
   * `section` defaults to nearly a viewport tall in base.scss, which is right
   * for the homepage and wrong for a page that is one short panel. Without
   * this the panel stretched to 684px around 316px of card and left 368px of
   * empty dot screen under it. `.thanks__slot` and `.colophon__slot` already
   * carry the same line; this one was missed.
   */
  min-height: 0;
}

.notfound__body {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  padding: 1.5rem;
  text-align: center;
}

.notfound__title {
  font-size: clamp(2rem, 7vmin, 3rem);
  line-height: 1;
  margin: 0;
}

.notfound__home {
  margin-top: .5rem;
}
</style>
