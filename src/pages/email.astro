---
/**
 * The email design studio, dev-only in substance: a faithful 600px mock of
 * the Shopify order-confirmation email (glizzy branch) where every colour is
 * a picker, every line of copy is editable in place, and Save writes the
 * whole state to studio/email-design.json via the dev server
 * (`__email-design-save` in astro.config.mjs). The JSON is the handoff —
 * whoever ports the design into the real notification template reads it
 * instead of a description in prose.
 *
 * GUARDRAILS ARE THE POINT (Adam, 2026-08-28: "we have limited options with
 * email so i guess we should have some guardrails baked in"):
 *  - The client switch renders the SAME design as Apple Mail (webfonts,
 *    radius), Gmail (system fonts only — the view most buyers get), and
 *    Outlook (no radius either). If it only looks good in Apple Mail, the
 *    other two tabs say so before it ships.
 *  - Fonts come from a fixed menu, and EVERY fallback is the system sans
 *    stack (Adam's call — no Georgia surprises in Gmail).
 *  - Contrast badges score the ink pairs live. Below 4.5:1 goes red.
 *  - No layout controls: Shopify's template owns the structure; the studio
 *    owns tokens, spacing and words.
 *
 * The site palette in the rail is PARSED FROM vars.scss at build — touch a
 * colour control, then click a chip to apply it. Derived, never copied, so
 * a palette edit reaches the studio for free.
 *
 * The built page is a stub — the studio exists only where its save endpoint
 * does, on the dev server.
 */
import varsRaw from '../styles/_globals/vars.scss?raw';

/* The design state is FETCHED at runtime, never imported: importing the JSON
 * puts it in Vite's module graph, and every save then full-reloads the page
 * — which ate Adam's inspector edits twice before this. */
const DEV = import.meta.env.DEV;

/* Only the base :root hexes — the P3 overrides use color() and fall out of
 * the match on their own. */
const palette = [...varsRaw.matchAll(/--([a-z-]+):\s*(#[0-9a-fA-F]{3,8})\b/g)].map(
  ([, name, hex]) => ({ name, hex })
);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Email studio — Glizzy</title>
    {DEV && <style is:global>
      @font-face { font-family: 'BN Magnolia'; src: url('/fonts/BNMagnolia.woff2') format('woff2'); font-display: swap; }
      @font-face { font-family: 'Sequoia Sans'; src: url('/fonts/SequoiaSans-Regular.woff2') format('woff2'); font-weight: 400; font-display: swap; }
      @font-face { font-family: 'Sequoia Sans Wide'; src: url('/fonts/SequoiaSans-Wide.woff2') format('woff2'); font-display: swap; }
      @font-face { font-family: 'Bricolage Grotesque'; src: url('/fonts/BricolageGrotesque-VF.woff2') format('woff2-variations'); font-weight: 400 500; font-display: swap; }

      :root {
        --ui-bg: #000d60;
        --ui-panel: #001080;
        --ui-ink: #f7e0c5;
        --ui-accent: #ffa300;
        --ui-line: rgba(247, 224, 197, 0.18);
      }
      * { box-sizing: border-box; }
      body { margin: 0; display: grid; grid-template-columns: 330px 1fr; min-height: 100vh; background: #e9e5df; font-family: 'Bricolage Grotesque', system-ui, sans-serif; }

      /* ── control rail ─────────────────────────────────────────────── */
      .rail { background: var(--ui-bg); color: var(--ui-ink); padding: 18px 16px 90px; overflow-y: auto; max-height: 100vh; position: sticky; top: 0; }
      .rail h1 { font-family: 'BN Magnolia', serif; font-weight: normal; font-size: 1.7rem; color: var(--ui-accent); margin: 0 0 2px; }
      .rail .sub { font-size: 0.72rem; opacity: 0.65; margin: 0 0 14px; line-height: 1.45; }
      .rail fieldset { border: 1px solid var(--ui-line); border-radius: 6px; margin: 0 0 14px; padding: 10px 12px 12px; }
      .rail legend { font-family: 'Sequoia Sans', sans-serif; font-size: 0.68rem; letter-spacing: 0.18em; padding: 0 6px; }
      .row { display: flex; align-items: center; gap: 8px; margin: 7px 0; }
      .row label { flex: 1; font-size: 0.78rem; }
      .row input[type='color'] { width: 34px; height: 26px; border: 1px solid var(--ui-line); border-radius: 4px; background: none; padding: 1px; }
      .row input[type='color'].armed { outline: 2px solid var(--ui-accent); outline-offset: 1px; }
      .row input[type='range'] { flex: 1.2; accent-color: var(--ui-accent); }
      .row output { font-size: 0.7rem; opacity: 0.7; min-width: 3ch; text-align: right; font-variant-numeric: tabular-nums; }
      .row select { flex: 1.4; background: var(--ui-panel); color: var(--ui-ink); border: 1px solid var(--ui-line); border-radius: 4px; font-size: 0.75rem; padding: 4px; }
      .badge { font-size: 0.62rem; padding: 2px 7px; border-radius: 99px; font-variant-numeric: tabular-nums; background: #1d7a3c; color: #fff; }
      .badge.bad { background: #b3261e; }
      .hint { font-size: 0.66rem; opacity: 0.6; line-height: 1.4; margin: 6px 0 0; }

      /* the palette, straight out of vars.scss */
      .chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 4px; }
      .chip { width: 100%; display: flex; align-items: center; gap: 8px; background: none; border: 1px solid var(--ui-line); border-radius: 5px; padding: 4px 8px 4px 4px; cursor: pointer; color: var(--ui-ink); font-family: inherit; }
      .chip:hover { border-color: var(--ui-accent); }
      .chip i { width: 22px; height: 22px; border-radius: 4px; border: 1px solid rgba(255,255,255,0.25); }
      .chip .n { font-size: 0.72rem; }
      .chip .h { margin-left: auto; font-size: 0.66rem; opacity: 0.6; font-variant-numeric: tabular-nums; }

      .savebar { position: fixed; bottom: 0; left: 0; width: 330px; padding: 12px 16px; background: var(--ui-bg); border-top: 1px solid var(--ui-line); display: flex; gap: 8px; align-items: center; }
      .savebar input[type='text'] { flex: 1; background: var(--ui-panel); color: var(--ui-ink); border: 1px solid var(--ui-line); border-radius: 4px; padding: 7px 9px; font-size: 0.75rem; }
      .savebar button { background: var(--ui-accent); border: 0; color: #000d60; font-weight: 700; padding: 8px 16px; border-radius: 4px; cursor: pointer; font-size: 0.8rem; }
      .savebar button:active { transform: translateY(1px); }
      #save-note { font-size: 0.7rem; }

      /* ── stage ───────────────────────────────────────────────────── */
      .stage { padding: 26px 20px 60px; display: flex; flex-direction: column; align-items: center; }
      .clients { display: flex; gap: 4px; margin-bottom: 6px; background: #d8d2c8; border-radius: 99px; padding: 3px; }
      .clients button { border: 0; background: none; padding: 6px 16px; border-radius: 99px; font-size: 0.76rem; cursor: pointer; font-family: inherit; }
      .clients button[aria-pressed='true'] { background: #fff; font-weight: 600; }
      .client-note { font-size: 0.72rem; color: #6b6459; margin: 0 0 16px; min-height: 1.2em; }

      /* the mock: exactly 600px like the shipped email */
      .email { width: 600px; max-width: 100%; box-shadow: 0 8px 40px rgba(0, 0, 0, 0.14); }
      .email [contenteditable] { outline: none; }
      .email [contenteditable]:hover { box-shadow: inset 0 0 0 1px rgba(255, 163, 0, 0.45); }
      .email [contenteditable]:focus { box-shadow: inset 0 0 0 2px rgba(255, 163, 0, 0.8); }
      .em-band { display: flex; justify-content: space-between; align-items: center; }
      .em-wordmark { text-decoration: none; }
      .em-ordertag { font-size: 14px; }
      .em-body { font-family: -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif; line-height: 1.5; }
      .em-h2 { font-weight: 600; margin: 0 0 8px; }
      .em-btn { display: block; text-align: center; color: #fff; font-weight: 600; text-decoration: none; }
      .em-btn--shop { background: #5433eb; }
      .em-or { text-align: center; margin: 14px 0 4px; }
      .em-cert { text-align: center; }
      .em-cert .kicker { margin: 0 0 6px; font-size: 11px; letter-spacing: 0.24em; text-transform: uppercase; }
      .em-cert h3 { margin: 0 0 10px; font-size: 18px; }
      .em-cert p.body { margin: 0 auto 18px; max-width: 42em; font-size: 14px; line-height: 1.5; }
      .em-cert .cert-btn { display: inline-block; padding: 12px 26px; font-weight: 700; text-decoration: none; }
      .em-summary { font-family: -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif; font-size: 14px; }
      .em-summary h3 { font-size: 18px; margin: 18px 0 12px; }
      .em-line { display: flex; align-items: center; gap: 12px; padding: 12px 0; }
      .em-thumb { width: 56px; height: 56px; border-radius: 6px; background: #000d60; display: grid; place-items: center; overflow: hidden; }
      .em-thumb span { width: 10px; height: 34px; border-radius: 6px; background: #dc512a; transform: rotate(24deg); }
      .em-line .amt { margin-left: auto; }
      .em-totals div { display: flex; justify-content: space-between; padding: 3px 0; }
      .em-totals .grand { font-weight: 700; font-size: 16px; margin-top: 6px; padding-top: 8px; }

      .stub { font-family: system-ui; padding: 4rem; color: #444; }
    </style>}
  </head>
  <body>
    {!DEV && <p class="stub">The email studio runs on the dev server only — <code>npm run dev</code>, then /email.</p>}
    {DEV && (
      <>
        <aside class="rail">
          <h1>Email studio</h1>
          <p class="sub">
            The order-confirmation email, glizzy branch. Click any text in the
            mock to rewrite it; Save writes <code>studio/email-design.json</code>.
          </p>

          <fieldset>
            <legend>SITE PALETTE</legend>
            <div class="chips" id="chips"></div>
            <p class="hint">Straight out of vars.scss. Touch a colour control, then click a chip to pour it in.</p>
          </fieldset>

          <fieldset>
            <legend>HEADER</legend>
            <div class="row"><label>Band</label><span class="badge" id="c-band">–</span><input type="color" data-k="band" /></div>
            <div class="row"><label>Wordmark ink</label><input type="color" data-k="ink" /></div>
            <div class="row"><label>Order-tag ink</label><input type="color" data-k="tagInk" /></div>
            <div class="row"><label>Wordmark face</label>
              <select data-k="wordmarkFont">
                <option value="magnolia">BN Magnolia · where supported</option>
                <option value="sequoia-wide">Sequoia Wide · where supported</option>
                <option value="system">System sans (safe everywhere)</option>
              </select>
            </div>
            <div class="row"><label>Size</label><input type="range" min="22" max="52" data-k="wordmarkSize" /><output id="o-wordmarkSize"></output></div>
            <div class="row"><label>Tracking</label><input type="range" min="-0.02" max="0.2" step="0.005" data-k="wordmarkTracking" /><output id="o-wordmarkTracking"></output></div>
            <div class="row"><label>Band padding</label><input type="range" min="14" max="56" data-k="bandPad" /><output id="o-bandPad"></output></div>
            <p class="hint">"Where supported" = Apple Mail and friends. Everyone else falls back to SYSTEM SANS, always — check the Gmail tab.</p>
          </fieldset>

          <fieldset>
            <legend>COLOR</legend>
            <div class="row"><label>Email background</label><input type="color" data-k="emailBg" /></div>
            <div class="row"><label>Accent (button, links)</label><span class="badge" id="c-accent">–</span><input type="color" data-k="accent" /></div>
            <div class="row"><label>Section headings</label><input type="color" data-k="h3Color" /></div>
            <div class="row"><label>Body text</label><input type="color" data-k="text" /></div>
            <div class="row"><label>Rules / dividers</label><input type="color" data-k="rule" /></div>
          </fieldset>

          <fieldset>
            <legend>TYPE + SPACING</legend>
            <div class="row"><label>Headline size</label><input type="range" min="17" max="32" data-k="headlineSize" /><output id="o-headlineSize"></output></div>
            <div class="row"><label>Body size</label><input type="range" min="12" max="18" data-k="bodySize" /><output id="o-bodySize"></output></div>
            <div class="row"><label>Side padding</label><input type="range" min="14" max="48" data-k="sidePad" /><output id="o-sidePad"></output></div>
            <div class="row"><label>Block gap</label><input type="range" min="10" max="48" data-k="blockGap" /><output id="o-blockGap"></output></div>
            <div class="row"><label>Button height</label><input type="range" min="10" max="22" data-k="buttonPadY" /><output id="o-buttonPadY"></output></div>
            <div class="row"><label>Button radius</label><input type="range" min="0" max="24" data-k="buttonRadius" /><output id="o-buttonRadius"></output></div>
            <p class="hint">Outlook (Windows) ignores radius — its tab previews that.</p>
          </fieldset>

          <fieldset>
            <legend>CERTIFICATE PANEL</legend>
            <div class="row"><label>Paper</label><input type="color" data-k="cert.paper" /></div>
            <div class="row"><label>Panel text</label><span class="badge" id="c-certtext">–</span><input type="color" data-k="cert.textInk" /></div>
            <div class="row"><label>Border</label><input type="color" data-k="cert.border" /></div>
            <div class="row"><label>Border width</label><input type="range" min="0" max="10" data-k="cert.borderWidth" /><output id="o-cert.borderWidth"></output></div>
            <div class="row"><label>Corner radius</label><input type="range" min="0" max="20" data-k="cert.radius" /><output id="o-cert.radius"></output></div>
            <div class="row"><label>Padding</label><input type="range" min="14" max="48" data-k="cert.pad" /><output id="o-cert.pad"></output></div>
            <div class="row"><label>Kicker ink</label><input type="color" data-k="cert.kickerColor" /></div>
            <div class="row"><label>Heading ink</label><input type="color" data-k="cert.headingColor" /></div>
            <div class="row"><label>Button</label><span class="badge" id="c-certbtn">–</span><input type="color" data-k="cert.buttonBg" /></div>
            <div class="row"><label>Button ink</label><input type="color" data-k="cert.buttonInk" /></div>
          </fieldset>

          <p class="hint">
            Fixed on purpose: 600px width, the layout, the purple Shop button
            (Shopify draws it), the order-summary structure. What's here is
            the full set of levers that survive real email clients.
          </p>

          <div class="savebar">
            <input type="text" id="note" placeholder="what changed (optional)" />
            <button id="save">Save</button>
            <span id="save-note"></span>
          </div>
        </aside>

        <main class="stage">
          <div class="clients" role="tablist">
            <button aria-pressed="true" data-client="apple">Apple Mail</button>
            <button aria-pressed="false" data-client="gmail">Gmail</button>
            <button aria-pressed="false" data-client="outlook">Outlook</button>
          </div>
          <p class="client-note" id="client-note"></p>

          <div class="email" id="email">
            <div class="em-band" id="band">
              <a class="em-wordmark" id="wordmark" contenteditable="true">Glizzy Store</a>
              <span class="em-ordertag" id="ordertag">ORDER #1003</span>
            </div>
            <div class="em-body" id="embody">
              <p class="em-h2" id="headline" contenteditable="true" data-c="headline"></p>
              <p contenteditable="true" data-c="body"></p>
              <a class="em-btn" id="btn-primary" contenteditable="true" data-c="primaryButton"></a>
              <a class="em-btn em-btn--shop" id="btn-shop">Track order with <b>shop</b></a>
              <p class="em-or">or <a id="store-link" contenteditable="true" data-c="storeLink"></a></p>
            </div>
            <div class="em-cert" id="cert">
              <p class="kicker" id="cert-kicker" contenteditable="true"></p>
              <h3 id="cert-h" contenteditable="true"></h3>
              <p class="body" id="cert-body" contenteditable="true"></p>
              <a class="cert-btn" id="cert-btn" contenteditable="true"></a>
            </div>
            <div class="em-summary" id="summary">
              <h3 class="em-h3">Order summary</h3>
              <div class="em-line" id="em-line">
                <span class="em-thumb"><span></span></span>
                <span>Glizzy × 1</span>
                <span class="amt">$1,000.00</span>
              </div>
              <div class="em-totals">
                <div><span>Subtotal</span><span>$1,000.00</span></div>
                <div><span>Shipping</span><span>$0.00</span></div>
                <div class="grand" id="em-grand"><span>Total</span><span>$1,000.00 USD</span></div>
              </div>
            </div>
          </div>
        </main>

        <script is:inline src="/js/inspect-capture.js" defer></script>
        <script define:vars={{ palette }}>
          (async () => {
          const savedDesign = (await fetch('/__email-design-save').then((r) => r.json())).design;
          /* Old saves load over fresh defaults, so new controls never break a
             file written before they existed. */
          const DEFAULTS = {
            band: '#000d60', ink: '#f7e0c5', tagInk: '', accent: '#dc512a',
            text: '#333333', h3Color: '#dc512a', emailBg: '#ffffff', rule: '#e5e5e5',
            wordmarkFont: 'magnolia', wordmarkSize: 38, wordmarkTracking: 0.02,
            bandPad: 28, headlineSize: 22, bodySize: 15, sidePad: 24, blockGap: 26,
            buttonPadY: 15, buttonRadius: 4,
            copy: {
              headline: 'Thank you for your order!',
              body: "We're getting your order ready to be shipped. We will notify you when it has been sent.",
              primaryButton: 'View your order',
              storeLink: 'Visit our store',
            },
            cert: {
              paper: '#f7e0c5', textInk: '#1a0e04', border: '#dc512a', borderWidth: 3,
              radius: 0, pad: 28,
              kicker: 'Glizzy Store · Bureau of Provenance', kickerColor: '#6b5744',
              heading: 'Certificate of authenticity', headingColor: '#dc512a',
              body: 'Every Glizzy leaves the kiln with papers. Yours are drawn up, numbered, and on file:',
              buttonLabel: 'View your certificate', buttonBg: '#dc512a', buttonInk: '#f7e0c5',
            },
          };
          const state = {
            ...DEFAULTS, ...savedDesign,
            copy: { ...DEFAULTS.copy, ...(savedDesign.copy || {}) },
            cert: { ...DEFAULTS.cert, ...(savedDesign.cert || {}) },
          };
          if (state.wordmarkFont === 'georgia') state.wordmarkFont = 'system';
          if (!state.tagInk) state.tagInk = state.ink;

          /* every fallback is the system sans stack — Adam's rule */
          const SYSTEM = "-apple-system, 'Segoe UI', Helvetica, Arial, sans-serif";
          const FONTS = {
            magnolia: { css: "'BN Magnolia', " + SYSTEM, fallback: SYSTEM },
            'sequoia-wide': { css: "'Sequoia Sans Wide', " + SYSTEM, fallback: SYSTEM },
            system: { css: SYSTEM, fallback: SYSTEM },
          };
          const CLIENTS = {
            apple: { webfonts: true, radius: true, note: 'Apple Mail: webfonts and radius both render — the best case.' },
            gmail: { webfonts: false, radius: true, note: 'Gmail strips @font-face — system sans, the view most buyers see.' },
            outlook: { webfonts: false, radius: false, note: 'Outlook for Windows: system fonts, square corners. The floor.' },
          };
          let client = 'apple';

          const $ = (s) => document.querySelector(s);
          const get = (k) => k.split('.').reduce((o, p) => o[p], state);
          const set = (k, v) => { const parts = k.split('.'); const last = parts.pop(); parts.reduce((o, p) => o[p], state)[last] = v; };

          const lum = (hex) => { const [r, g, b] = [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16) / 255).map((c) => (c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4)); return 0.2126 * r + 0.7152 * g + 0.0722 * b; };
          const ratio = (a, b) => { const [x, y] = [lum(a), lum(b)].sort((m, n) => n - m); return (x + 0.05) / (y + 0.05); };
          const scoreBadge = (el, fg, bg) => { const r = ratio(fg, bg); el.textContent = r.toFixed(1); el.classList.toggle('bad', r < 4.5); };

          function render() {
            const c = CLIENTS[client];
            $('#client-note').textContent = c.note;
            const face = (key) => (c.webfonts ? FONTS[key].css : FONTS[key].fallback);
            const radius = c.radius ? state.buttonRadius + 'px' : '0';
            const pad = state.sidePad + 'px';

            $('#email').style.background = state.emailBg;

            const band = $('#band');
            band.style.background = state.band;
            band.style.padding = `${state.bandPad}px ${pad}`;
            const wm = $('#wordmark');
            wm.style.color = state.ink;
            wm.style.fontFamily = face(state.wordmarkFont);
            wm.style.fontSize = state.wordmarkSize + 'px';
            wm.style.letterSpacing = state.wordmarkTracking + 'em';
            $('#ordertag').style.color = state.tagInk;

            const body = $('#embody');
            body.style.color = state.text;
            body.style.fontSize = state.bodySize + 'px';
            body.style.padding = `${state.blockGap + 4}px ${pad} 10px`;
            $('#headline').style.fontSize = state.headlineSize + 'px';
            $('#headline').style.color = state.text;

            const primary = $('#btn-primary');
            primary.style.background = state.accent;
            primary.style.borderRadius = radius;
            primary.style.padding = `${state.buttonPadY}px 0`;
            primary.style.marginTop = '18px';
            const shop = $('#btn-shop');
            shop.style.borderRadius = radius;
            shop.style.padding = `${state.buttonPadY}px 0`;
            shop.style.marginTop = '12px';
            $('#store-link').style.color = state.accent;

            const cert = $('#cert');
            cert.style.background = state.cert.paper;
            cert.style.color = state.cert.textInk;
            cert.style.border = `${state.cert.borderWidth}px solid ${state.cert.border}`;
            cert.style.borderRadius = (c.radius ? state.cert.radius : 0) + 'px';
            cert.style.margin = `${state.blockGap}px ${pad}`;
            cert.style.padding = `${state.cert.pad}px 22px`;
            $('#cert-kicker').style.color = state.cert.kickerColor;
            $('#cert-h').style.color = state.cert.headingColor;
            $('#cert-body').style.color = state.cert.textInk;
            const cb = $('#cert-btn');
            cb.style.background = state.cert.buttonBg;
            cb.style.color = state.cert.buttonInk;
            cb.style.borderRadius = radius;

            const summary = $('#summary');
            summary.style.color = state.text;
            summary.style.padding = `4px ${pad} ${state.blockGap + 6}px`;
            document.querySelectorAll('.em-summary h3').forEach((h) => (h.style.color = state.h3Color));
            $('#em-line').style.borderBottom = `1px solid ${state.rule}`;
            $('#em-grand').style.borderTop = `2px solid ${state.text}`;

            scoreBadge($('#c-band'), state.ink, state.band);
            scoreBadge($('#c-accent'), '#ffffff', state.accent);
            scoreBadge($('#c-certbtn'), state.cert.buttonInk, state.cert.buttonBg);
            scoreBadge($('#c-certtext'), state.cert.textInk, state.cert.paper);
            document.querySelectorAll('input[type="range"][data-k]').forEach((i) => {
              const o = document.getElementById('o-' + i.dataset.k);
              if (o) o.textContent = i.dataset.k === 'wordmarkTracking' ? Number(get(i.dataset.k)).toFixed(3) : get(i.dataset.k);
            });
          }

          /* copy: contenteditable in the mock IS the state */
          for (const el of document.querySelectorAll('[data-c]')) {
            const k = el.dataset.c;
            el.textContent = state.copy[k];
            el.addEventListener('input', () => (state.copy[k] = el.textContent));
          }
          const certCopy = { kicker: $('#cert-kicker'), heading: $('#cert-h'), body: $('#cert-body'), buttonLabel: $('#cert-btn') };
          for (const [k, el] of Object.entries(certCopy)) {
            el.textContent = state.cert[k];
            el.addEventListener('input', () => (state.cert[k] = el.textContent));
          }

          /* controls */
          let armed = null; // the colour control a palette chip pours into
          document.querySelectorAll('[data-k]').forEach((input) => {
            const k = input.dataset.k;
            input.value = get(k);
            input.addEventListener('input', () => {
              set(k, input.type === 'range' ? Number(input.value) : input.value);
              render();
            });
            if (input.type === 'color') {
              const arm = () => {
                document.querySelectorAll('.armed').forEach((x) => x.classList.remove('armed'));
                input.classList.add('armed');
                armed = input;
              };
              input.addEventListener('focus', arm);
              input.addEventListener('click', arm);
            }
          });

          /* the palette chips, from vars.scss */
          const chips = $('#chips');
          for (const { name, hex } of palette) {
            const b = document.createElement('button');
            b.className = 'chip';
            b.innerHTML = `<i style="background:${hex}"></i><span class="n">--${name}</span><span class="h">${hex}</span>`;
            b.addEventListener('click', () => {
              if (!armed) return;
              armed.value = hex.length === 4 ? '#' + [...hex.slice(1)].map((c) => c + c).join('') : hex;
              set(armed.dataset.k, armed.value);
              render();
            });
            chips.appendChild(b);
          }

          document.querySelectorAll('[data-client]').forEach((b) =>
            b.addEventListener('click', () => {
              client = b.dataset.client;
              document.querySelectorAll('[data-client]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
              render();
            })
          );

          /*
           * Save HARVESTS the DOM first, because DevTools is a legitimate
           * design tool here: whatever the inspector did to the mock's
           * elements — colours, paddings, sizes — is read back off computed
           * style into the state before it is written. Learned the hard way:
           * saving writes the JSON the page imports, Vite reloads the page,
           * and un-harvested inspector edits died with it (Adam, twice,
           * 2026-08-28).
           */
          const toHex = (rgb) => {
            const m = rgb.match(/rgba?\(([\d.]+)[, ]+([\d.]+)[, ]+([\d.]+)/);
            if (!m) return null;
            return '#' + [m[1], m[2], m[3]].map((n) => Math.round(Number(n)).toString(16).padStart(2, '0')).join('');
          };
          const px = (v) => Math.round(parseFloat(v) || 0);
          function harvest() {
            const cs = (el) => getComputedStyle(el);
            const c = CLIENTS[client];
            const band = cs($('#band')), wm = cs($('#wordmark')), bodyS = cs($('#embody'));
            const prim = cs($('#btn-primary')), cert = cs($('#cert')), cb = cs($('#cert-btn'));

            state.band = toHex(band.backgroundColor) ?? state.band;
            state.bandPad = px(band.paddingTop) || state.bandPad;
            state.sidePad = px(bodyS.paddingLeft) || state.sidePad;
            state.ink = toHex(wm.color) ?? state.ink;
            state.wordmarkSize = px(wm.fontSize) || state.wordmarkSize;
            const ls = parseFloat(wm.letterSpacing);
            state.wordmarkTracking = Number.isFinite(ls) ? Number((ls / parseFloat(wm.fontSize)).toFixed(3)) : 0;
            state.tagInk = toHex(cs($('#ordertag')).color) ?? state.tagInk;

            state.emailBg = toHex(cs($('#email')).backgroundColor) ?? state.emailBg;
            state.text = toHex(bodyS.color) ?? state.text;
            state.bodySize = px(bodyS.fontSize) || state.bodySize;
            state.headlineSize = px(cs($('#headline')).fontSize) || state.headlineSize;
            state.accent = toHex(prim.backgroundColor) ?? state.accent;
            state.buttonPadY = px(prim.paddingTop) || state.buttonPadY;
            if (c.radius) state.buttonRadius = px(prim.borderRadius);
            state.h3Color = toHex(cs(document.querySelector('.em-summary h3')).color) ?? state.h3Color;
            state.rule = toHex(cs($('#em-line')).borderBottomColor) ?? state.rule;

            state.cert.paper = toHex(cert.backgroundColor) ?? state.cert.paper;
            state.cert.border = toHex(cert.borderTopColor) ?? state.cert.border;
            state.cert.borderWidth = px(cert.borderTopWidth);
            if (c.radius) state.cert.radius = px(cert.borderRadius);
            state.cert.pad = px(cert.paddingTop) || state.cert.pad;
            state.cert.kickerColor = toHex(cs($('#cert-kicker')).color) ?? state.cert.kickerColor;
            state.cert.headingColor = toHex(cs($('#cert-h')).color) ?? state.cert.headingColor;
            state.cert.textInk = toHex(cs($('#cert-body')).color) ?? state.cert.textInk;
            state.cert.buttonBg = toHex(cb.backgroundColor) ?? state.cert.buttonBg;
            state.cert.buttonInk = toHex(cb.color) ?? state.cert.buttonInk;

            // the rail follows the harvest, so what you saved is what you see
            document.querySelectorAll('[data-k]').forEach((i) => (i.value = get(i.dataset.k)));
          }

          $('#save').addEventListener('click', async () => {
            const noteEl = $('#save-note');
            noteEl.textContent = '…';
            harvest();
            /* every style="" inside the mock, verbatim — element.style is
               where DevTools edits live, so this catches what the harvest's
               schema doesn't */
            const cssPath = (el) => { const parts = []; let n = el; while (n && n.id !== 'email') { parts.unshift(n.id ? '#' + n.id : n.tagName.toLowerCase() + (n.className ? '.' + String(n.className).split(' ')[0] : '')); n = n.parentElement; } return '#email ' + parts.join(' > '); };
            const inlineStyles = [...document.querySelectorAll('#email [style]')].map((el) => ({ path: cssPath(el), css: el.getAttribute('style') }));
            try {
              const res = await fetch('/__email-design-save', {
                method: 'POST',
                headers: { 'content-type': 'application/json' },
                body: JSON.stringify({ design: state, note: $('#note').value, inlineStyles }),
              });
              const json = await res.json();
              noteEl.textContent = json.ok ? 'saved ✓' : 'failed: ' + json.error;
            } catch (e) {
              noteEl.textContent = 'failed: ' + e.message;
            }
            setTimeout(() => (noteEl.textContent = ''), 4000);
          });

          render();
          })();
        </script>
      </>
    )}
  </body>
</html>
