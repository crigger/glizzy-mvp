---
/**
 * The tuner — which is the homepage's stereogram, with knobs bolted on.
 *
 * It renders the real `GlizzyStereo` rather than a copy of it. The previous
 * version was a bespoke full-screen layout with its own sizing, which meant
 * every number found here had to be re-checked against the homepage by hand,
 * and twice did not survive the trip: the panel had a different width, and a
 * different height, than the thing it was supposed to be tuning. Rendering the
 * component puts it in the same `section`, the same window chrome, the same
 * `contain` framing, so a setting that reads well here reads well there.
 *
 * The controls reach the engine through `window.glizzyStereo`, the handle the
 * component publishes.
 *
 * Colour is deliberately absent: the homepage pins an explicit palette now, so
 * a count slider here would drive nothing. /stereo-colours is where palettes
 * are chosen, and it shows every one at this same size.
 *
 * noindex, off the nav.
 */
import Layout from '../layouts/Layout.astro';
import GlizzyStereo from '../components/GlizzyStereo.astro';
---

<Layout title="Stereogram tuner — Glizzy Store" description="Tuning the homepage stereogram." scripts={false} noindex>
  <GlizzyStereo />

  <button id="btn-tune" class="tuner__toggle" aria-expanded="false">tune</button>

  <div class="tuner" id="bar">
    <div class="tuner__btns">
      <button id="btn-freeze" aria-pressed="false">freeze</button>
      <button id="btn-depth" aria-pressed="false">depth</button>
      <button id="btn-guide" aria-pressed="false">guides</button>
      <button id="btn-invert" aria-pressed="false">invert</button>
      <button id="btn-tone" aria-pressed="false">2-tone</button>
    </div>
    <div class="tuner__row"><label for="s-sep">period</label><input id="s-sep" type="range" min="55" max="220" step="1" value="101" /><output id="o-sep"></output></div>
    <div class="tuner__row"><label for="s-dot">dot</label><input id="s-dot" type="range" min="1" max="6" step="1" value="2" /><output id="o-dot"></output></div>
    <div class="tuner__row"><label for="s-plane">planes</label><input id="s-plane" type="range" min="2" max="33" step="1" value="33" /><output id="o-plane"></output></div>
    <div class="tuner__row"><label for="s-gain">relief</label><input id="s-gain" type="range" min="10" max="100" step="5" value="80" /><output id="o-gain"></output></div>
    <div class="tuner__row"><label for="s-spin">spin</label><input id="s-spin" type="range" min="0" max="100" step="5" value="0" /><output id="o-spin"></output></div>
    <div class="tuner__row"><label for="s-fill">fill</label><input id="s-fill" type="range" min="70" max="220" step="5" value="135" /><output id="o-fill"></output></div>
    <div class="tuner__row"><label for="s-lift">lift</label><input id="s-lift" type="range" min="0" max="80" step="5" value="40" /><output id="o-lift"></output></div>
    <div class="tuner__row"><label for="s-room">room</label><input id="s-room" type="range" min="0" max="100" step="5" value="0" /><output id="o-room"></output></div>
    <div class="tuner__row"><label for="s-wall">wall</label><input id="s-wall" type="range" min="2" max="40" step="1" value="30" /><output id="o-wall"></output></div>
    <div class="tuner__row"><label for="s-wig">wiggle</label><input id="s-wig" type="range" min="4" max="72" step="1" value="17" /><output id="o-wig"></output></div>
    <div class="tuner__row"><label for="s-wigms">rate</label><input id="s-wigms" type="range" min="300" max="2400" step="50" value="300" /><output id="o-wigms"></output></div>
    <div class="tuner__row"><label for="s-blur">blur</label><input id="s-blur" type="range" min="0" max="6" step="1" value="0" /><output id="o-blur"></output></div>
    <p class="tuner__status" id="status"></p>
  </div>
</Layout>

<style lang="scss">
  .tuner__toggle {
    position: fixed;
    z-index: 5;
    right: 10px;
    bottom: calc(10px + env(safe-area-inset-bottom));
    width: auto;
    padding: 12px 20px;
    background: #1c1c1c;
    color: #d8d8d8;
    border: 1px solid #555;
    border-radius: 4px;
    font: 12px/1.4 ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: 0.04em;
    cursor: pointer;
    box-shadow: 0 2px 12px rgb(0 0 0 / 70%);
  }
  .tuner__toggle[aria-expanded='true'] { background: #4a2113; border-color: var(--dog-color); color: #ffd9c9; }

  /*
   * Overlays, never shares height with the stereogram — the whole point is that
   * the panel keeps the size it has on the homepage while it is being tuned.
   */
  .tuner {
    position: fixed;
    z-index: 4;
    left: 50%;
    bottom: 0;
    width: 100%;
    max-width: 640px;
    transform: translate(-50%, 100%);
    transition: transform 0.18s ease-out;
    max-height: 78dvh;
    overflow-y: auto;
    padding: 10px 10px calc(64px + env(safe-area-inset-bottom));
    background: #111;
    border-top: 1px solid #262626;
    font: 12px/1.4 ui-monospace, SFMono-Regular, Menlo, monospace;
    color: #d8d8d8;
  }
  .tuner.is-open { transform: translate(-50%, 0); }
  @media (prefers-reduced-motion: reduce) { .tuner { transition: none; } }

  .tuner__btns { display: flex; gap: 6px; margin-bottom: 10px; }
  .tuner__btns button {
    flex: 1 1 auto; padding: 9px 8px; background: #1c1c1c; color: #d8d8d8;
    border: 1px solid #333; border-radius: 4px; font: inherit; cursor: pointer;
  }
  .tuner__btns button[aria-pressed='true'] { background: #4a2113; border-color: var(--dog-color); color: #ffd9c9; }

  .tuner__row { display: flex; align-items: center; gap: 8px; margin: 2px 0; }
  .tuner__row label { flex: 0 0 56px; color: #8a8a8a; }
  .tuner__row output { flex: 0 0 46px; text-align: right; font-variant-numeric: tabular-nums; }
  .tuner input[type='range'] { flex: 1 1 auto; min-width: 0; accent-color: var(--dog-color); height: 34px; }
  .tuner__status { color: #6a6a6a; font-size: 11px; margin: 8px 0 0; min-height: 1.4em; }
</style>

<script>
  const barEl = document.getElementById('bar');
  const tuneBtn = document.getElementById('btn-tune');
  const statusEl = document.getElementById('status');

  function closeDrawer() {
    barEl.classList.remove('is-open');
    tuneBtn.setAttribute('aria-expanded', 'false');
    tuneBtn.textContent = 'tune';
  }
  tuneBtn.addEventListener('click', () => {
    const open = barEl.classList.toggle('is-open');
    tuneBtn.setAttribute('aria-expanded', String(open));
    tuneBtn.textContent = open ? 'close' : 'tune';
  });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeDrawer(); });

  /* The component may boot before or after this script; take whichever arrives. */
  function withDog(fn) {
    if (window.glizzyStereo) fn(window.glizzyStereo);
    else document.addEventListener('stereo:ready', (e) => fn(e.detail), { once: true });
  }

  withDog((dog) => {
    function report() {
      const s = dog.stats();
      statusEl.textContent =
        `${s.gW}×${s.gH} · ${s.fps} fps · gpu depth · ` +
        `repeat ${dog.params.sep}px (E=${s.E})` +
        `${s.dot !== dog.params.dot ? ' · dot→' + s.dot : ''}` +
        `${dog.params.spin === 0 ? ' · still' : ''}`;
    }
    setInterval(report, 500);

    function bind(id, key, fmt) {
      const el = document.getElementById('s-' + id);
      const out = document.getElementById('o-' + id);
      /* Seed from the engine, so the sliders show what the homepage actually
         ships rather than whatever was typed into the markup. */
      el.value = dog.params[key];
      const sync = () => {
        dog.setParam(key, +el.value);
        out.textContent = fmt ? fmt(+el.value) : el.value;
        report();
      };
      el.addEventListener('input', sync);
      sync();
    }

    function toggle(id, apply, initial = false) {
      const b = document.getElementById(id);
      /* Seeded, like the sliders: a toggle that reads "off" while the engine
         has it on is a control that lies. */
      let on = initial;
      b.setAttribute('aria-pressed', String(on));
      b.addEventListener('click', () => {
        on = !on;
        b.setAttribute('aria-pressed', String(on));
        apply(on);
      });
    }

    bind('sep', 'sep', (v) => v + 'px');
    bind('dot', 'dot');
    bind('plane', 'planes', (v) => (v > 32 ? 'smooth' : v));
    bind('gain', 'gain', (v) => v + '%');
    bind('spin', 'spin', (v) => (v === 0 ? 'off' : v + '%'));
    bind('fill', 'fill', (v) => v + '%');
    bind('lift', 'lift', (v) => v + '%');
    bind('room', 'room', (v) => (v === 0 ? 'off' : v + '%'));
    bind('wall', 'wall', (v) => v + '%');
    bind('blur', 'blur');
    /* Only bite in the wiggle view — switch to it with the panel's own button.
       They are here because they are exactly the kind of number this page
       exists for: picked by watching the thing move, not by argument. */
    bind('wig', 'wig', (v) => v + 'px');
    bind('wigms', 'wigMs', (v) => v + 'ms');

    toggle('btn-freeze', (v) => dog.setFrozen(v));
    toggle('btn-depth', (v) => dog.setShowDepth(v));
    toggle('btn-guide', (v) => dog.setGuides(v));
    toggle('btn-invert', (v) => dog.setInvert(v));
    /* every view: darkest + lightest brand colour, one light dot in four */
    toggle('btn-tone', (v) => dog.setParam('tone', v ? 1 : 0), dog.params.tone === 1);

    report();
  });
</script>
