---
/**
 * How the store was made, and by whom.
 *
 * A route rather than a slab at the bottom of the homepage: the homepage is a
 * hot dog, and a credits list is not part of that scroll. Linked from the site
 * note at the very bottom of every page (see SiteNote.astro), which is where
 * someone who wants this goes looking.
 *
 * EVERY CREDIT HERE IS CHECKED. The type attributions were read out of the
 * fonts' own `name` tables, not from memory:
 *
 *   BN Magnolia          Brandon Nickerson / BN Type   bnicks.com
 *   Bricolage Grotesque  Atelier Triay                 OFL, on GitHub
 *   Sequoia Sans         Chris Breuer                  SIL OFL 1.1
 *
 * Sequoia Sans is credited to its AUTHOR, not to the org name on the repo:
 * github.com/national-park-service/fonts is a personal project of Chris
 * Breuer's, described as "National Park Service INSPIRED", and every commit in
 * it is his. Crediting the Park Service would be crediting a government agency
 * for a stranger's work.
 *
 * If a face is added or dropped, re-read the table rather than guessing —
 * `python3 -c "from fontTools.ttLib import TTFont; ..."` on the woff2 prints
 * copyright, designer and licence URL.
 *
 * `scripts={false}`: no dog and none of its four-screen body height, same as
 * /thanks and /shop.
 */
import Layout from '../layouts/Layout.astro';
import SiteIcon from '../components/SiteIcon.astro';
import WindowPanel from '../components/WindowPanel.astro';
import { AUTHOR } from '../lib/productJsonLd';

/**
 * Every credit renders the same two lines: the NAME, then who or where it came
 * from. `by` is a person, a studio or a place; with an `href` the attribution
 * links, and without one it is plain text. An item with only an `href` puts the
 * hostname on the second line, which is the shape for a tool that is its own
 * credit.
 *
 * There is no third line. The `note` field ("the dog", "headless, Storefront
 * API", "hosting, forms, the certificate") is gone — vinton.land dropped its
 * copy of it on 2026-09-10 and this follows. Note that the REASON does not
 * port: over there the note was faded on a ground with only one body-safe ink,
 * so `opacity` walked it under AA. Here it measured 6.25 and was fine. It went
 * because a credit list wants one shape, not because it was unreadable.
 *
 * `by` also absorbed the two notes that were really attributions — Studio 228
 * is IN Vinton, which is a "where it came from" and belongs on that line.
 */
interface Credit {
  name: string;
  by?: string;
  href?: string;
}
interface Section {
  label: string;
  items: Credit[];
}

const sections: Section[] = [
  {
    label: 'Type',
    items: [
      { name: 'BN Magnolia', by: 'Brandon Nickerson', href: 'https://bnicks.com' },
      {
        name: 'Bricolage Grotesque',
        by: 'Atelier Triay',
        href: 'https://github.com/ateliertriay/bricolage',
      },
      { name: 'Sequoia Sans', by: 'Chris Breuer', href: 'https://github.com/chrisbbreuer' },
    ],
  },
  {
    label: 'Thanks to',
    items: [{ name: 'Studio 228', by: 'Vinton, Virginia' }],
  },
  {
    label: 'Built with',
    items: [
      { name: 'Astro', href: 'https://astro.build' },
      { name: 'three.js', href: 'https://threejs.org' },
      { name: 'GSAP', href: 'https://gsap.com' },
      { name: 'Shopify', href: 'https://shopify.com' },
      { name: 'Netlify', href: 'https://netlify.com' },
    ],
  },
  /*
   * A NAME, NOT A LINK, and in the NAME slot — the author is the biggest credit
   * on the page, not the small line under an empty one. "Who is behind this" is
   * the question a trust check asks before any of the others, and an agent went
   * to a web search for it rather than find it here.
   *
   * LAST rather than first, which is where it sat until 2026-09-10. Opening a
   * credits page by crediting yourself reads as a byline; closing with it reads
   * as a signature, and the page is a list of other people either way.
   */
  {
    label: 'Created by',
    items: [{ name: AUTHOR.name }],
  },
];
---

<Layout
  title="Colophon — Glizzy Store"
  description="How the Glizzy Store was made, and who made the parts of it that were not made here."
  scripts={false}
>
  <SiteIcon />

  <main class="colophon">
    <section class="colophon__slot" aria-labelledby="colophon-title">
      <WindowPanel title="Credits">
        <div class="colophon__body">
          <h1 class="colophon__title f-sequoia" id="colophon-title">Colophon</h1>

          {
            sections.map((section) => (
              <section class="colophon__section">
                <h2 class="colophon__label f-sequoia">{section.label}</h2>
                {/*
                  `f-bricolage` because `.f-*` is opt-in and `body` is
                  `system-ui` — see the note in fonts.scss. Without it every
                  credit on this page renders in the visitor's OS UI font, which
                  is how it shipped until 2026-09-10.
                */}
                <ul class="colophon__list f-bricolage">
                  {section.items.map((item) => (
                    <li class="colophon__item">
                      <span class="colophon__name">{item.name}</span>
                      {(item.by || item.href) && (
                        <span class="colophon__by">
                          {item.href ? (
                            <a href={item.href} rel="noopener noreferrer" target="_blank">
                              {item.by ?? new URL(item.href).hostname.replace(/^www\./, '')}
                            </a>
                          ) : (
                            item.by
                          )}
                        </span>
                      )}
                    </li>
                  ))}
                </ul>
              </section>
            ))
          }

          {/* The standard blue pill, same as /404 and the prose pages. */}
          <a class="shop-button colophon__home" href="/">Home</a>
        </div>
      </WindowPanel>
    </section>
  </main>
</Layout>
