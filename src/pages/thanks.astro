---
/**
 * Where a successful contact submission lands.
 *
 * Netlify redirects here itself, from the form's `action` — this page is never
 * linked from anywhere. It exists so a sent message ends on the site rather
 * than on Netlify's generic confirmation screen.
 *
 * It wears the window treatment (2026-08-29). Before that it borrowed the
 * contact block's classes WITHOUT the panel those classes are written for, so
 * four lines of type sat bare in the top-left corner of an empty navy screen
 * under a full-width blue pill. The card is what the rest of the site is made
 * of; a confirmation is the last thing a person sees, so it gets one too.
 *
 * `scripts={false}`: no dog, and none of the four-screen body height it
 * assumes. This is four lines of text; the dog would open it onto empty
 * screens, the same reason /shop and /type set it.
 */
import Layout from '../layouts/Layout.astro';
import SiteIcon from '../components/SiteIcon.astro';
import WindowPanel from '../components/WindowPanel.astro';
---

<Layout
  title="Thanks — Glizzy Store"
  description="Your message is on its way."
  scripts={false}
  noindex
>
  <SiteIcon />

  <main class="thanks">
    <section class="thanks__slot" aria-labelledby="thanks-title">
      <WindowPanel title="Message sent">
        <div class="thanks__body">
          <h1 class="thanks__title f-sequoia" id="thanks-title">Thanks</h1>
          <p class="thanks__note">
            Your message made it. Someone will read it.
          </p>
          <a class="shop-button shop-button--quiet thanks__back" href="/">Back</a>
        </div>
      </WindowPanel>
    </section>
  </main>
</Layout>
