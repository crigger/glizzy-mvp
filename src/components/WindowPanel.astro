---
/**
 * The window panel: keyline, dot screen, bone card, and a gold title bar when
 * it has a title.
 *
 * Shared by every panel on the page, because they differ in how they are
 * POSITIONED and not in what they are made of:
 *
 *   GlizzyWindow  sticky in a tall section, draggable by the bar
 *   IntroGlizzy   static, sitting in the flow, no bar at all
 *
 * `draggable` is what adds `js-drag-handle`, and that class is the only thing
 * glizzy-windows.js keys off — it also carries `cursor: grab` and
 * `touch-action: none`. A static panel must NOT have it: the bar would claim to
 * be draggable and would swallow a swipe over a strip nothing can drag.
 */
interface Props {
  /** Omit for a panel with no chrome bar — see `.window--untitled`. */
  title?: string;
  draggable?: boolean;
  /**
   * Media edge-to-edge: no padding and no bone card, the slot sits directly
   * under the chrome. For a panel whose content IS an image — the bone card
   * exists to put type on, and framing a photograph with it reads as a mat
   * that nothing chose. The PDP's art window is the first user.
   */
  flush?: boolean;
}
const { title, draggable = false, flush = false } = Astro.props;
---

<div class:list={['window', !title && 'window--untitled', flush && 'window--flush']}>
  {
    title && (
      <div class:list={['window-chrome', draggable && 'js-drag-handle']}>
        <span class="window-title">{title}</span>
      </div>
    )
  }
  <div class="window-content">
    {/*
      The copy sits on an opaque card, never on the glass. That is what lets the
      panel behind it be as transparent and as busy as it likes — the contrast
      is between the type and the card, and nothing else.

      A flush panel skips the card entirely: its content is opaque media, and
      the no-text-on-glass rule has nothing to protect.
    */}
    {flush ? <slot /> : <div class="window-content__inner"><slot /></div>}
  </div>
</div>
