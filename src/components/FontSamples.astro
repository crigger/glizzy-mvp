---
/**
 * Type specimens for every .f-* utility.
 *
 * A working reference, not part of the finished page — it is here because the
 * old index.html had it. If it stays it wants its own route rather than a
 * section on the homepage.
 */
---

<section>
  <h2>Font samples</h2>
  <div class="font-samples">
    <div class="font-sample">
      <span class="label">.f-sequoia-thin</span>
      <p class="specimen f-sequoia-thin">Glizzy is a hot dog</p>
      <p class="pangram  f-sequoia-thin">The quick brown fox jumps over the lazy dog · 0123456789</p>
    </div>
    <div class="font-sample">
      <span class="label">.f-sequoia-light</span>
      <p class="specimen f-sequoia-light">Glizzy is a hot dog</p>
      <p class="pangram  f-sequoia-light">The quick brown fox jumps over the lazy dog · 0123456789</p>
    </div>
    <div class="font-sample">
      <span class="label">.f-sequoia</span>
      <p class="specimen f-sequoia">Glizzy is a hot dog</p>
      <p class="pangram  f-sequoia">The quick brown fox jumps over the lazy dog · 0123456789</p>
    </div>
    <div class="font-sample">
      <span class="label">.f-sequoia-wide</span>
      <p class="specimen f-sequoia-wide">Glizzy is a hot dog</p>
      <p class="pangram  f-sequoia-wide">The quick brown fox jumps over the lazy dog · 0123456789</p>
    </div>
    <div class="font-sample">
      <span class="label">.f-magnolia</span>
      <p class="specimen f-magnolia">Glizzy is a hot dog</p>
      <p class="pangram  f-magnolia">The quick brown fox jumps over the lazy dog · 0123456789</p>
    </div>
    <div class="font-sample">
      <span class="label">.f-bricolage-light</span>
      <p class="specimen f-bricolage-light">Glizzy is a hot dog</p>
      <p class="pangram  f-bricolage-light">The quick brown fox jumps over the lazy dog · 0123456789</p>
    </div>
    <div class="font-sample">
      <span class="label">.f-bricolage</span>
      <p class="specimen f-bricolage">Glizzy is a hot dog</p>
      <p class="pangram  f-bricolage">The quick brown fox jumps over the lazy dog · 0123456789</p>
    </div>
    <div class="font-sample">
      <span class="label">.f-bricolage-bold</span>
      <p class="specimen f-bricolage-bold">Glizzy is a hot dog</p>
      <p class="pangram  f-bricolage-bold">The quick brown fox jumps over the lazy dog · 0123456789</p>
    </div>
    <div class="font-sample">
      <span class="label">.f-bricolage-condensed</span>
      <p class="specimen f-bricolage-condensed">condensed glizzy</p>
    </div>
    <div class="font-sample">
      <span class="label">.f-bricolage-text vs .f-bricolage-display (opsz 12 ↔ 96)</span>
      <p class="specimen f-bricolage-text">opsz 12 — display-set spaced like text</p>
      <p class="specimen f-bricolage-display">opsz 96 — text-set spaced like display</p>
    </div>
  </div>
</section>
